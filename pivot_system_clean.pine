//@version=5
indicator('피봇 시스템', overlay=true)

// ==================== 입력 설정 ====================
showMultiZone = input.bool(true, '피봇 박스 표시', group='표시')
showST = input.bool(true, 'ST 피봇 표시', group='표시')
showIT = input.bool(true, 'IT 피봇 표시', group='표시')
showLT = input.bool(true, 'LT 피봇 표시', group='표시')
showBOSMSS = input.bool(true, 'BOS/MSS 표시', group='표시')

multiPercent = input.float(0.2, '피봇 박스 범위 (%)', minval=0.1, maxval=1.0, step=0.05, group='설정')

colorST = input.color(color.new(color.green, 0), 'ST 피봇 색상', group='색상')
colorIT = input.color(color.new(color.blue, 60), 'IT 피봇 색상', group='색상')
colorLT = input.color(color.new(color.red, 60), 'LT 피봇 색상', group='색상')

// ==================== 데이터 구조 ====================
type PivotPoint
    float price
    int barIndex

// ==================== 전역 변수 ====================
atr = (ta.atr(3) / close) * 100
sma200 = ta.sma(close, 200)
sma60 = ta.sma(close, 60)
sma20 = ta.sma(close, 20)

// ==================== 배열 선언 ====================
var array<PivotPoint> stHighArray = array.new<PivotPoint>()
var array<PivotPoint> stLowArray = array.new<PivotPoint>()
var array<PivotPoint> itHighArray = array.new<PivotPoint>()
var array<PivotPoint> itLowArray = array.new<PivotPoint>()
var array<PivotPoint> ltHighArray = array.new<PivotPoint>()
var array<PivotPoint> ltLowArray = array.new<PivotPoint>()

// ==================== 박스 및 시장 구조 변수 ====================
var box itHighBox = na
var box itLowBox = na
var box ltHighBox = na
var box ltLowBox = na

var int marketStructure = 0  // 1: Bullish, -1: Bearish, 0: Neutral
var int lastBOSSTHighBar = na
var int lastBOSSTLowBar = na
var int bosConsecutiveCount = 0

// ==================== 함수 정의 ====================

// 피봇 추가 함수 - 배열 크기 관리
f_addPivot(arr, p, maxSize) =>
    result = false
    if not na(p)
        array.push(arr, p)
        if array.size(arr) > maxSize
            array.shift(arr)
        result := true
    result

// BOS/MSS 체크 함수
f_checkBOS(stArr, isBull, mktStr, lastBOSBar) =>
    newMktStr = mktStr
    newLine = line(na)
    newBox = box(na)
    newLastBOSBar = lastBOSBar

    if array.size(stArr) > 0
        lastPivot = array.get(stArr, array.size(stArr) - 1)

        alreadyProcessed = not na(lastBOSBar) and lastBOSBar == lastPivot.barIndex
        crossed = isBull ? ta.crossover(close, lastPivot.price) : ta.crossunder(close, lastPivot.price)

        if crossed and not alreadyProcessed
            lbl = (isBull and mktStr == -1) or (not isBull and mktStr == 1) ? "MSS" : "BOS"
            col = isBull ? #089981 : #f23645

            newLine := line.new(lastPivot.barIndex, lastPivot.price, bar_index, lastPivot.price,
                               color=col, width=2)
            newBox := box.new(lastPivot.barIndex, lastPivot.price, bar_index, lastPivot.price,
                             na, na, text=lbl, text_size=size.small,
                             text_halign=text.align_center,
                             text_valign=isBull ? text.align_bottom : text.align_top,
                             text_color=col)
            newMktStr := isBull ? 1 : -1
            newLastBOSBar := lastPivot.barIndex

    [newMktStr, newLine, newBox, newLastBOSBar]

// 피봇 박스 그리기 함수
f_drawBox(arr, oldBox, col, findHigh) =>
    box.delete(oldBox)
    closest = PivotPoint.new(na, na)
    minD = 999999.0
    maxBars = 100

    // 현재가에서 가장 가까운 피봇 찾기
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            p = array.get(arr, i)
            barDiff = bar_index - p.barIndex

            if barDiff <= maxBars
                // High 피봇은 현재가보다 위, Low 피봇은 아래만 선택
                if findHigh ? p.price > close : p.price < close
                    d = math.abs(p.price - close)
                    if d < minD
                        minD := d
                        closest := p

    box newBox = na

    if not na(closest.price)
        boxTop = closest.price * (1 + multiPercent / 100)
        boxBot = closest.price * (1 - multiPercent / 100)
        newBox := box.new(closest.barIndex, boxTop, bar_index + 20, boxBot,
                         bgcolor=color.new(col, 90),
                         border_color=color.new(col, 60))

    newBox

// ==================== 메인 로직 ====================

// 1. IT 피봇 감지 (현재 차트, 5/5)
itHigh = ta.pivothigh(high, 5, 5)
itLow = ta.pivotlow(low, 5, 5)

if not na(itHigh)
    pt = PivotPoint.new(itHigh, bar_index - 5)
    if f_addPivot(itHighArray, pt, 50) and showIT
        label.new(bar_index - 5, itHigh, "▼", style=label.style_none,
                 textcolor=colorIT, size=size.small, yloc=yloc.abovebar)

if not na(itLow)
    pt = PivotPoint.new(itLow, bar_index - 5)
    if f_addPivot(itLowArray, pt, 50) and showIT
        label.new(bar_index - 5, itLow, "▲", style=label.style_none,
                 textcolor=colorIT, size=size.small, yloc=yloc.belowbar)

// 2. ST 피봇 감지 (현재 차트, Long 캔들 또는 Big Gap 조건)
// Long 캔들 체크
t = atr * 3
s = math.abs(high - low) / close * 100
hasLong = (s[3] >= t) or (s[2] >= t) or (s[1] >= t)

// Big Gap 체크
hasBigGapHigh = false
hasBigGapLow = false
if not na(itHigh) and array.size(itHighArray) > 1
    prevPivot = array.get(itHighArray, array.size(itHighArray) - 2)
    priceGap = math.abs(itHigh - prevPivot.price) / close * 100
    hasBigGapHigh := priceGap >= atr * 5

if not na(itLow) and array.size(itLowArray) > 1
    prevPivot = array.get(itLowArray, array.size(itLowArray) - 2)
    priceGap = math.abs(itLow - prevPivot.price) / close * 100
    hasBigGapLow := priceGap >= atr * 5

// ST 피봇 추가 (IT 피봇 중 조건 만족하는 것만)
if not na(itHigh) and (hasLong or hasBigGapHigh)
    pt = PivotPoint.new(itHigh, bar_index - 5)
    if f_addPivot(stHighArray, pt, 50) and showST
        label.new(bar_index - 5, itHigh, "▼", style=label.style_none,
                 textcolor=colorST, size=size.normal, yloc=yloc.abovebar)

if not na(itLow) and (hasLong or hasBigGapLow)
    pt = PivotPoint.new(itLow, bar_index - 5)
    if f_addPivot(stLowArray, pt, 50) and showST
        label.new(bar_index - 5, itLow, "▲", style=label.style_none,
                 textcolor=colorST, size=size.normal, yloc=yloc.belowbar)

// 3. LT 피봇 감지 (현재 차트, 20/20)
ltHigh = ta.pivothigh(high, 20, 20)
ltLow = ta.pivotlow(low, 20, 20)

if not na(ltHigh)
    pt = PivotPoint.new(ltHigh, bar_index - 20)
    if f_addPivot(ltHighArray, pt, 30) and showLT
        label.new(bar_index - 20, ltHigh, "▼", style=label.style_none,
                 textcolor=colorLT, size=size.large, yloc=yloc.abovebar)

if not na(ltLow)
    pt = PivotPoint.new(ltLow, bar_index - 20)
    if f_addPivot(ltLowArray, pt, 30) and showLT
        label.new(bar_index - 20, ltLow, "▲", style=label.style_none,
                 textcolor=colorLT, size=size.large, yloc=yloc.belowbar)

// 4. BOS/MSS 판정 (ST 피봇 기준)
if showBOSMSS
    [newMktStr1, newLine1, newBox1, newBOSBar1] = f_checkBOS(stHighArray, true, marketStructure, lastBOSSTHighBar)
    if not na(newLine1)
        if marketStructure == -1
            bosConsecutiveCount := 1
        else
            bosConsecutiveCount += 1

        marketStructure := newMktStr1
        lastBOSSTHighBar := newBOSBar1

    [newMktStr2, newLine2, newBox2, newBOSBar2] = f_checkBOS(stLowArray, false, marketStructure, lastBOSSTLowBar)
    if not na(newLine2)
        if marketStructure == 1
            bosConsecutiveCount := 1
        else
            bosConsecutiveCount += 1

        marketStructure := newMktStr2
        lastBOSSTLowBar := newBOSBar2

// 5. 피봇 박스 그리기
if showMultiZone
    itHighBox := f_drawBox(itHighArray, itHighBox, colorIT, true)
    itLowBox := f_drawBox(itLowArray, itLowBox, colorIT, false)
    ltHighBox := f_drawBox(ltHighArray, ltHighBox, colorLT, true)
    ltLowBox := f_drawBox(ltLowArray, ltLowBox, colorLT, false)

// 6. 이동평균선
plot(sma200, 'SMA 200', color=color.new(color.orange, 50), linewidth=2)
plot(sma60, 'SMA 60', color=color.new(color.blue, 70), linewidth=1)
plot(sma20, 'SMA 20', color=color.new(color.green, 70), linewidth=1)
